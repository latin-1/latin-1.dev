---
import CollectionItem from "../../components/CollectionItem.astro";
import CollectionList from "../../components/CollectionList.astro";
import games from "../../data/collections/games.json" with { type: "json" };
import PageLayout from "../../layouts/PageLayout.astro";
---

<PageLayout title="Game Collection" backHref="/collections/">
  {Array.from(Map.groupBy(games, (game) => game.year))
    .toSorted((a, b) => b[0] - a[0])
    .map(([year, games]) => (
      <>
        <h2 class="mt-8 mb-4 font-heading text-2xl font-bold text-mauve-900">
          {year !== -1 ? year : "Earlier"}
        </h2>
        <div class="my-4">
          <CollectionList>
            {games.map((game) => (
              <CollectionItem
                name={game.name}
                nameLang={game.nameLang}
                coverPath={game.coverPath}
                coverAspectRatio="2 / 3"
              />
            ))}
          </CollectionList>
        </div>
      </>
    ))}
</PageLayout>
