---
import AssetImage from "../../components/AssetImage.astro";
import InteractiveCard from "../../components/InteractiveCard.astro";
import events from "../../data/collections/events.json" with { type: "json" };
import games from "../../data/collections/games.json" with { type: "json" };
import PageLayout from "../../layouts/PageLayout.astro";

const collections = [
  {
    name: "Events",
    href: "/collections/events/",
    items: events.toSorted((a, b) => b.year - a.year),
  },
  {
    name: "Games",
    href: "/collections/games/",
    items: games.toSorted((a, b) => b.year - a.year),
  },
];
---

<PageLayout title="Collections">
  <div
    class="my-4 grid grid-cols-[repeat(auto-fill,minmax(--spacing(80),1fr))] gap-4"
  >
    {collections.map((collection) => (
      <InteractiveCard
        as="a"
        class="flex flex-col rounded-2xl p-2"
        href={collection.href}
      >
        <figure class="rounded-lg bg-mauve-100 p-1">
          <div class="grid grid-cols-3 gap-1">
            {collection.items.slice(0, 3).map((item) => (
              <AssetImage
                class="aspect-square w-full rounded-sm bg-white object-cover"
                path={item.coverPath}
                alt=""
              />
            ))}
          </div>
        </figure>
        <div class="p-4">
          <h3 class="text-lg font-semibold">{collection.name}</h3>
          <p class="text-sm font-medium text-mauve-500">
            {collection.items.length === 1
              ? `${collection.items.length} item`
              : `${collection.items.length} items`}
          </p>
        </div>
      </InteractiveCard>
    ))}
  </div>
</PageLayout>
