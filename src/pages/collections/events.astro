---
import CollectionItem from "../../components/CollectionItem.astro";
import CollectionList from "../../components/CollectionList.astro";
import events from "../../data/collections/events.json" with { type: "json" };
import PageLayout from "../../layouts/PageLayout.astro";
---

<PageLayout title="Event Collection" backHref="/collections/">
  {Array.from(Map.groupBy(events, (event) => event.year))
    .toSorted((a, b) => b[0] - a[0])
    .map(([year, events]) => (
      <>
        <h2 class="mt-8 mb-4 font-heading text-2xl font-bold text-mauve-900">
          {year !== -1 ? year : "Earlier"}
        </h2>
        <div class="my-4">
          <CollectionList>
            {events.map((event) => (
              <CollectionItem
                name={event.name}
                description={event.description}
                coverPath={event.coverPath}
                coverAspectRatio="3 / 4"
              />
            ))}
          </CollectionList>
        </div>
      </>
    ))}
</PageLayout>
