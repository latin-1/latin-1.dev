---
import CollectionItem from "../../components/CollectionItem.astro";
import CollectionList from "../../components/CollectionList.astro";
import events from "../../data/collections/events.json" with { type: "json" };
import PageLayout from "../../layouts/PageLayout.astro";

const sortedEvents = events.toSorted((a, b) => b.year - a.year);
---

<PageLayout title="Event Collection" backHref="/collections/">
  {Map.groupBy(sortedEvents, (event) => event.year)
    .entries()
    .map(([year, events]) => (
      <>
        <h2 class="mt-8 mb-4 font-heading text-2xl font-bold text-mauve-900 before:mr-2 before:text-pink-900 before:content-['#']">
          {year !== -1 ? year : "Earlier"}
        </h2>
        <div class="my-4">
          <CollectionList>
            {events.map((event) => (
              <CollectionItem
                name={event.name}
                nameLang={event.nameLang}
                description={event.description}
                descriptionLang={event.descriptionLang}
                coverPath={event.coverPath}
                coverAspectRatio="3 / 4"
              />
            ))}
          </CollectionList>
        </div>
      </>
    ))}
</PageLayout>
