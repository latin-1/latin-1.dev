---
import InteractiveCard from "../components/InteractiveCard.astro";
import projects from "../data/projects.json" with { type: "json" };
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="Projects">
  <div
    class="my-4 grid grid-cols-[repeat(auto-fill,minmax(--spacing(80),1fr))] gap-4"
  >
    {projects.map((project) => (
      <InteractiveCard
        as="a"
        class="flex flex-col gap-2 rounded-2xl p-6"
        href={project.link}
        target="_blank"
        rel="noreferrer"
      >
        <h3 class="text-lg font-semibold">{project.name}</h3>
        <p class="text-sm font-medium text-mauve-500">{project.summary}</p>
      </InteractiveCard>
    ))}
  </div>
</PageLayout>
