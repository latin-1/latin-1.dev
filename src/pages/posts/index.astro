---
import { getCollection } from "astro:content";
import InteractiveCard from "../../components/InteractiveCard.astro";
import PageLayout from "../../layouts/PageLayout.astro";

const posts = await getCollection("posts");
const sortedPosts = posts.toSorted((a, b) =>
  Temporal.PlainDate.compare(b.data.publishedAt, a.data.publishedAt),
);
---

<PageLayout title="Posts">
  {Map.groupBy(sortedPosts, (post) => post.data.publishedAt.year)
    .entries()
    .map(([year, posts]) => (
      <>
        <h2 class="heading mt-8 mb-4">{year}</h2>
        <div class="my-4 grid grid-cols-[repeat(auto-fill,minmax(--spacing(80),1fr))] gap-4">
          {posts.map((post) => (
            <InteractiveCard
              as="a"
              class="flex flex-col gap-2 rounded-2xl p-6"
              href={`/posts/${post.data.slug}/`}
            >
              <h3 class="text-lg font-semibold">{post.data.title}</h3>
              <p class="text-sm font-medium text-mauve-500">
                {post.data.publishedAt.toLocaleString("en", {
                  month: "long",
                  day: "numeric",
                })}
              </p>
            </InteractiveCard>
          ))}
        </div>
      </>
    ))}
</PageLayout>
