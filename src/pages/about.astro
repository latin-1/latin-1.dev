---
import {
  IconBrandGithub,
  IconBrandSteam,
  IconBrandX,
  IconDeviceIpad,
  IconDeviceLaptop,
  IconDeviceMobile,
  IconDeviceNintendo,
  IconKey,
  IconMail,
} from "@tabler/icons-astro";
import AssetImage from "../components/AssetImage.astro";
import devices from "../data/devices.json" with { type: "json" };
import socials from "../data/socials.json" with { type: "json" };
import PageLayout from "../layouts/PageLayout.astro";

type SocialKind = "email" | "x" | "github" | "steam" | "key";

const socialIcons = {
  email: IconMail,
  x: IconBrandX,
  github: IconBrandGithub,
  steam: IconBrandSteam,
  key: IconKey,
} satisfies Record<SocialKind, unknown>;

type DeviceKind = "laptop" | "phone" | "tablet" | "nintendo-switch";

const deviceIcons = {
  laptop: IconDeviceLaptop,
  phone: IconDeviceMobile,
  tablet: IconDeviceIpad,
  "nintendo-switch": IconDeviceNintendo,
} satisfies Record<DeviceKind, unknown>;
---

<PageLayout title="About">
  <div class="my-4 flex flex-wrap items-start gap-3">
    {socials.map((social) => {
      const Icon = socialIcons[social.kind as SocialKind];
      return (
        <a
          class="flex items-center gap-2 rounded-full bg-sky-50 px-4 py-2 font-semibold text-sky-700 shadow-xs inset-ring inset-ring-sky-200 outline-sky-600 transition hover:-translate-y-0.5 hover:shadow-md hover:inset-ring-2 hover:inset-ring-sky-600 focus-visible:focus-ring"
          href={social.link}
          target="_blank"
          rel="noreferrer"
        >
          <Icon class="size-5" aria-hidden />
          <span class="px-1">{social.name}</span>
        </a>
      );
    })}
  </div>

  <figure class="my-8 rounded-3xl bg-mauve-100 p-2">
    <AssetImage
      class="w-full rounded-2xl bg-white"
      path="cover.webp"
      alt=""
      loading="eager"
    />
  </figure>

  <h2 class="mt-8 mb-4 font-heading text-2xl font-bold text-mauve-900">
    My devices
  </h2>
  <div
    class="my-4 grid grid-cols-[repeat(auto-fill,minmax(--spacing(80),1fr))] gap-4"
  >
    {devices.map((device) => {
      const Icon = deviceIcons[device.kind as DeviceKind];
      return (
        <div class="flex flex-col gap-2 rounded-2xl bg-white p-6 shadow-xs inset-ring inset-ring-mauve-200">
          <h3 class="flex items-center gap-2 text-lg font-semibold text-mauve-900">
            <Icon class="size-6 shrink-0" aria-hidden />
            <span class="truncate">{device.name}</span>
          </h3>
          <p class="text-sm font-medium text-mauve-500">{device.summary}</p>
        </div>
      );
    })}
  </div>
</PageLayout>
