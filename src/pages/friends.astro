---
import { Image } from "astro:assets";
import InteractiveCard from "../components/InteractiveCard.astro";
import friends from "../data/friends.json" with { type: "json" };
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="Friends">
  <div
    class="my-4 grid grid-cols-[repeat(auto-fill,minmax(--spacing(60),1fr))] gap-3"
  >
    {friends.map((friend) => (
      <InteractiveCard
        as="a"
        class="flex rounded-2xl p-2"
        href={friend.link}
        target="_blank"
        rel="noreferrer"
      >
        <figure class="rounded-lg bg-mauve-100 p-0.5">
          <Image
            class="size-16 rounded-md bg-white"
            src={friend.avatarUrl.replaceAll("{size}", "128")}
            width={128}
            height={128}
            alt=""
          />
        </figure>
        <div class="flex min-w-0 flex-1 flex-col justify-center gap-1 px-4 py-2">
          <h3 class="truncate font-semibold" lang={friend.nameLang}>
            {friend.name}
          </h3>
          <p class="truncate text-sm font-medium text-mauve-500">
            {new URL(friend.link).hostname}
          </p>
        </div>
      </InteractiveCard>
    ))}
  </div>
</PageLayout>
