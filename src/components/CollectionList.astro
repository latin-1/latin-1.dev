---
import type { HTMLAttributes } from "astro/types";
import { cn } from "cn";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...props } = Astro.props;
---

<div
  class={cn(
    "grid grid-cols-[repeat(auto-fill,minmax(--spacing(40),1fr))] gap-4",
    className,
  )}
  {...props}
>
  <slot />
</div>
