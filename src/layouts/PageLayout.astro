---
import { IconChevronLeft } from "@tabler/icons-astro";
import Layout from "../layouts/Layout.astro";

interface Props {
  title: string;
  backHref?: string | undefined;
}

const { title, backHref = "/" } = Astro.props;
---

<Layout title={title}>
  <div class="mx-auto flex min-h-screen max-w-200 flex-col py-8">
    <header class="flex flex-col gap-2">
      <a
        class="-ml-1 flex w-fit items-center gap-1 rounded-xs text-lg font-semibold text-sky-700 outline-sky-600 hover:underline focus-visible:focus-ring"
        style={{
          "view-transition-name": "page-back-button",
          "view-transition-class": "shared",
        }}
        href={backHref}
      >
        <IconChevronLeft class="size-6" aria-hidden />
        <span>Back</span>
      </a>

      <h1 class="font-display text-5xl font-semibold text-mauve-900">
        <slot name="title">
          {title}
        </slot>
      </h1>

      {Astro.slots.has("metadata") && (
        <p class="font-medium text-mauve-500">
          <slot name="metadata" />
        </p>
      )}
    </header>

    <main>
      <div class="mt-8 mb-12">
        <slot />
      </div>
    </main>

    <footer
      class="mt-auto"
      style={{
        "view-transition-name": "page-footer",
        "view-transition-class": "shared",
      }}
    >
      <p class="font-medium text-mauve-500">Copyright &copy; Hikari Hayashi</p>
    </footer>
  </div>
</Layout>
