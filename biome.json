{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "useEditorconfig": true
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentObjectDefinitions": "warn"
      },
      "nursery": {
        "useTailwindSortedClasses": "warn",
        "useTailwindShorthandClasses": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedProperties": "on",
        "useSortedPackageJson": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "markdown": {
    "parser": {
      "frontmatter": true
    }
  },
  "tailwind": {
    "stylesheet": "./src/styles/index.css"
  }
}
